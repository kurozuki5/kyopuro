using ll=long long;
const ll INF=1ll<<60;

ll modpow(ll a,ll b,ll mod){
    ll res=1;
    while(b>0){
        if(b%2==1)res=res*a%mod;
        a=a*a%mod;
        b/=2;
    }
    return res;
}