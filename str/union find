#define rep(i, n) for (int i = 0; i < (int)(n); i++)
using ll=long long;
const ll INF=1ll<<60;

struct dsu{
    vector<int>par,siz;

    dsu(int n):par(n),siz(n,1){
        rep(i,n)par[i]=i;
    }

    int root(int x){
        if(par[x]==x)return x;
        return par[x]=root(par[x]);
    }

    void merge(int x,int y){
        int rx=root(x),ry=root(y);
        if(rx==ry)return;
        par[rx]=ry;
        siz[ry]+=siz[rx];
    }

    bool same(int x,int y){
        int rx=root(x),ry=root(y);
        return rx==ry;
    }

    int size(int x){
        return siz[root(x)];
    }
};