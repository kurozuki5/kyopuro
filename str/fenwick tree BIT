template <typename T>
struct BIT{
    int n;
    vector<T> bit;
    BIT(int n_):n(n_+1),bit(n,0){}

    void add(int i,T x){
        for(int idx=i;idx<n;idx+=(idx&-idx)){
            bit[idx]+=x;
        }
    }
    T sum(int i){
        T s(0);
        for(int idx=i;idx>0;idx-=(idx&-idx)){
            s+=bit[idx];
        }
        return s;
    }
};

